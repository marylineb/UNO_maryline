{% extends 'base.html.twig' %}

{% block title %}Fin de partie{% endblock %}

{% block body %}
<div class="end-container">
    <div class="end-card">
        <h1>Fin de partie</h1>

        <h2>
            🎉 {{ winner.name }} a gagné !
        </h2>

        <p>Merci d’avoir joué à MyUno</p>

        <div class="actions-zone">
            <a href="{{ path('new_game') }}" class="restart-btn">
                Rejouer
            </a>

            <a href="{{ path('home') }}" class="action-btn">
                Accueil
            </a>
        </div>
    </div>
</div>
{% endblock %}