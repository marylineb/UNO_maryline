{% extends 'base.html.twig' %}

{% block title %}Fin de partie{% endblock %}

{% block body %}
<div class="end-container">
    <h1>🎉 Fin de la partie 🎉</h1>

    {% if winner %}
        <h2>Le gagnant est : {{ winner.name }}</h2>
    {% else %}
        <p>Aucun gagnant.</p>
    {% endif %}

    <a href="{{ path('new_game') }}" class="restart-btn">
        Rejouer une partie
    </a>
</div>
{% endblock %}