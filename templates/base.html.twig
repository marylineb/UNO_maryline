<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}MyUno{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
</head>
<body>
    <header class="main-header">
        <div class="logo-zone">
            <a href="{{ path('home') }}" class="logo-link">MyUno</a>
            <p class="tagline">Une partie, trois adversaires, une seule gagnante</p>
        </div>

        <nav class="main-nav">
            <a href="{{ path('home') }}">Accueil</a>
            <a href="{{ path('new_game') }}">Nouvelle partie</a>
            <a href="{{ path('play') }}">Plateau</a>
        </nav>
    </header>

    <main class="page-content">
        {% block body %}{% endblock %}
    </main>
</body>
</html>