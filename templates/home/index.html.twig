{% extends 'base.html.twig' %}

{% block title %}Accueil - MyUno{% endblock %}

{% block body %}
<div class="home-container">
    <h1 class="home-title">Bienvenue sur MyUno</h1>

    <p class="intro">
        Affronte 3 adversaires et tente de te débarrasser de toutes tes cartes !
    </p>

    <div class="rules-box">
        <h2>Règles du jeu</h2>

        <ul class="rules-list">
            <li>Chaque joueur joue une carte à tour de rôle.</li>
            <li>Une carte est jouable si elle a la même couleur ou valeur.</li>
            <li><strong>+2</strong> : le joueur suivant pioche 2 cartes.</li>
            <li><strong>X</strong> : saute le tour du joueur suivant.</li>
            <li><strong>S</strong> : inverse le sens.</li>
            <li>Si tu ne peux pas jouer → tu pioches.</li>
            <li>Le premier à 0 carte gagne.</li>
        </ul>
    </div>

    <div class="start-zone">
        <a href="{{ path('new_game') }}" class="start-btn">
            Lancer une partie
        </a>
    </div>
</div>
{% endblock %}